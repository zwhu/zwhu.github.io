  "dialogues": [
    {"id": "interview-narrator", "state": "interview", "speaker": "narrator", "basis": "fact_paraphrase", "text": "原本录用的人嫌工资低，没来。"},
    {"id": "interview-boss-1", "state": "interview", "speaker": "boss", "basis": "fact", "text": "你能力不行，来了也干不了活。"},
    {"id": "interview-player", "state": "interview", "speaker": "player", "basis": "fact", "text": "我不要工资，让我来试试就行。"},
    {"id": "interview-boss-2", "state": "interview", "speaker": "boss", "basis": "fact", "text": "行，那你想试试我也不拦你，反正不要工资，到时候你自己也会受不了就走。"},
    {"id": "day-narrator", "state": "day_tasks", "speaker": "narrator", "basis": "fact_paraphrase", "text": "第一次用 Linux 开发机，第一次用 Git，第一次写前端，还第一次写 E2E 测试。不会的就 Google。"},
    {"id": "day-task", "state": "day_tasks", "speaker": "player", "basis": "staging", "text": "我在自己的工位坐下，接过电脑上的任务。"},
    {"id": "day-linux", "state": "day_tasks", "speaker": "player", "basis": "staging", "text": "这一屏是 Linux 开发机和 Git。"},
    {"id": "day-jquery", "state": "day_tasks", "speaker": "player", "basis": "staging", "text": "这一页是第一次写的前端，手边是《锋利的 jQuery》。"},
    {"id": "night-falls", "state": "day_tasks", "speaker": "narrator", "basis": "staging", "text": "天黑了。"},
    {"id": "night-narrator", "state": "night_study", "speaker": "narrator", "basis": "fact_paraphrase", "text": "天黑以后，我还在学。白天写前端，晚上啃 Java、数据库和 NoSQL。"},
    {"id": "night-java", "state": "night_study", "speaker": "player", "basis": "staging", "text": "这一本是 Java。"},
    {"id": "night-db", "state": "night_study", "speaker": "player", "basis": "staging", "text": "这一屏是数据库和 NoSQL。"},
    {"id": "days-pass", "state": "night_study", "speaker": "narrator", "basis": "fact_paraphrase", "text": "日夜颠倒地学新东西，拼命把活干好。"},
    {"id": "raise-narrator", "state": "raise", "speaker": "narrator", "basis": "fact_paraphrase", "text": "入职两个月，加了两次薪。"},
    {"id": "raise-boss", "state": "raise", "speaker": "boss", "basis": "fact", "text": "努力工作的人一定会被看到的。"},
    {"id": "manual-1", "state": "complete", "speaker": "manual", "basis": "fact", "text": "努力工作的人一定会被看到的。"}

  "dialogues": [
    {
      "id": "arrive-1",
      "state": "arrive",
      "speaker": "narrator",
      "basis": "staging",
      "text": "到杭州，来商品发布这边报到。"
    },
    {
      "id": "check-in",
      "state": "arrive",
      "speaker": "player",
      "basis": "staging",
      "text": "前台把工位指给我。这一摊是商品发布。"
    },
    {
      "id": "publish",
      "state": "arrive",
      "speaker": "player",
      "basis": "fact_paraphrase",
      "text": "我负责商品发布。先把这摊业务读懂，发布要服务后面的几条线。"
    },
    {
      "id": "night-falls",
      "state": "arrive",
      "speaker": "narrator",
      "basis": "staging",
      "text": "夜深了。设计模式的书还摊在桌上。"
    },
    {
      "id": "night-1",
      "state": "night",
      "speaker": "narrator",
      "basis": "staging",
      "text": "深夜。书摊开着，一页一页往下看。"
    },
    {
      "id": "patterns",
      "state": "night",
      "speaker": "player",
      "basis": "staging",
      "text": "这本是设计模式。二十三种，对着自己的代码往下读。"
    },
    {
      "id": "plugins-falls",
      "state": "night",
      "speaker": "narrator",
      "basis": "staging",
      "text": "书先放到这里。发布链路上的插件还没看完。"
    },
    {
      "id": "plugins-1",
      "state": "plugins",
      "speaker": "narrator",
      "basis": "staging",
      "text": "Webpack 一屏，Babel 一屏。插件从这里往下拆。"
    },
    {
      "id": "webpack",
      "state": "plugins",
      "speaker": "player",
      "basis": "staging",
      "text": "这一屏是 Webpack 的插件机制。"
    },
    {
      "id": "babel",
      "state": "plugins",
      "speaker": "player",
      "basis": "staging",
      "text": "这一屏是 Babel 的插件机制。"
    },
    {
      "id": "sheets-falls",
      "state": "plugins",
      "speaker": "narrator",
      "basis": "staging",
      "text": "两条插件都看过。五条业务线的需求单在桌上。"
    },
    {
      "id": "sheets-1",
      "state": "sheets",
      "speaker": "narrator",
      "basis": "staging",
      "text": "五张需求单，一条业务线一张。"
    },
    {
      "id": "line-1",
      "state": "sheets",
      "speaker": "player",
      "basis": "staging",
      "text": "第一条业务线的需求。"
    },
    {
      "id": "line-2",
      "state": "sheets",
      "speaker": "player",
      "basis": "staging",
      "text": "第二条业务线的需求。"
    },
    {
      "id": "line-3",
      "state": "sheets",
      "speaker": "player",
      "basis": "staging",
      "text": "第三条业务线的需求。"
    },
    {
      "id": "line-4",
      "state": "sheets",
      "speaker": "player",
      "basis": "staging",
      "text": "第四条业务线的需求。"
    },
    {
      "id": "line-5",
      "state": "sheets",
      "speaker": "player",
      "basis": "staging",
      "text": "第五条业务线的需求。"
    },
    {
      "id": "board-1",
      "state": "board",
      "speaker": "narrator",
      "basis": "staging",
      "text": "五张单子对齐。白板上五条线一起亮起来。"
    },
    {
      "id": "board-light",
      "state": "sheets",
      "speaker": "player",
      "basis": "staging",
      "text": "一套表单架构，撑起五条业务线。"
    },
    {
      "id": "finish",
      "state": "board",
      "speaker": "player",
      "basis": "staging",
      "text": "这一章先到这里。"
    },
    {
      "id": "manual-1",
      "state": "complete",
      "speaker": "manual",
      "basis": "staging",
      "text": "一套表单架构，撑起五条业务线。"
    }

  "dialogues": [
    {
      "id": "office-n1",
      "state": "office",
      "speaker": "narrator",
      "basis": "staging",
      "text": "南京的办公室，下午。屋里安静，只有键盘声。"
    },
    {
      "id": "office-first-pc-1",
      "state": "office",
      "speaker": "player",
      "basis": "staging",
      "text": "（打开论坛，看看怎么回事。）"
    },
    {
      "id": "office-n3",
      "state": "office",
      "speaker": "narrator",
      "basis": "fact_paraphrase",
      "text": "帖子很短：有用户说，登录页打不开自己的账号。这是这个项目第一次面对真实的线上用户。"
    },
    {
      "id": "office-n4",
      "state": "office",
      "speaker": "player",
      "basis": "staging",
      "text": "（先别慌，把这事告诉 CTO。）"
    },
    {
      "id": "office-reopen",
      "state": "office",
      "speaker": "narrator",
      "basis": "staging",
      "text": "论坛帖已经看过了。剩下的，得和 CTO 一起想办法。"
    },
    {
      "id": "observe-bookshelf-office",
      "state": "office",
      "speaker": "narrator",
      "basis": "staging",
      "text": "书架上摆着翻旧的 JavaScript 书。有本借出去又被人放回来的，书脊都弯了。（游戏里的观察，不代表当时的书架。）"
    },
    {
      "id": "observe-plant-office",
      "state": "office",
      "speaker": "narrator",
      "basis": "staging",
      "text": "窗边的绿植长得挺精神，谁空下来就顺手浇一点水。（游戏里的观察，不代表当时的样子。）"
    },
    {
      "id": "observe-mug-office",
      "state": "office",
      "speaker": "narrator",
      "basis": "staging",
      "text": "CTO 桌上的保温杯，贴着张旧贴纸，边角都翘起来了。（游戏里的观察，不代表当时的摆设。）"
    },
    {
      "id": "report-n1",
      "state": "report",
      "speaker": "narrator",
      "basis": "fact_paraphrase",
      "text": "我去找 CTO，把论坛里的反馈说给他听。"
    },
    {
      "id": "report-cto-1",
      "state": "report",
      "speaker": "cto",
      "basis": "fact_paraphrase",
      "text": "先别一个人扛。这事我带大家一起看看。"
    },
    {
      "id": "report-cto-2",
      "state": "report",
      "speaker": "cto",
      "basis": "staging",
      "text": "你先往工位那边走，我马上过去。"
    },
    {
      "id": "report-n2",
      "state": "report",
      "speaker": "narrator",
      "basis": "staging",
      "text": "CTO 放下杯子，跟我一起往工位那边走。"
    },
    {
      "id": "observe-bookshelf-report",
      "state": "report",
      "speaker": "narrator",
      "basis": "staging",
      "text": "书架上摆着翻旧的 JavaScript 书。有本借出去又被人放回来的，书脊都弯了。（游戏里的观察，不代表当时的书架。）"
    },
    {
      "id": "observe-plant-report",
      "state": "report",
      "speaker": "narrator",
      "basis": "staging",
      "text": "窗边的绿植长得挺精神，谁空下来就顺手浇一点水。（游戏里的观察，不代表当时的样子。）"
    },
    {
      "id": "observe-mug-report",
      "state": "report",
      "speaker": "narrator",
      "basis": "staging",
      "text": "CTO 桌上的保温杯，贴着张旧贴纸，边角都翘起来了。（游戏里的观察，不代表当时的摆设。）"
    },
    {
      "id": "incident-n1",
      "state": "incident",
      "speaker": "narrator",
      "basis": "fact_paraphrase",
      "text": "登录框打不开，按钮点了也没反应。"
    },
    {
      "id": "incident-player-1",
      "state": "incident",
      "speaker": "player",
      "basis": "staging",
      "text": "（……）"
    },
    {
      "id": "incident-n2",
      "state": "incident",
      "speaker": "narrator",
      "basis": "staging",
      "text": "我在椅子边上站了一会儿，脑子里空空的。"
    },
    {
      "id": "incident-cto-1",
      "state": "incident",
      "speaker": "cto",
      "basis": "staging",
      "text": "都过来，一起看看。别急，先弄清楚发生了什么。"
    },
    {
      "id": "incident-n3",
      "state": "incident",
      "speaker": "narrator",
      "basis": "staging",
      "text": "CTO 招呼几位同事过来。"
    },
    {
      "id": "investigation-n1",
      "state": "investigation",
      "speaker": "narrator",
      "basis": "fact_paraphrase",
      "text": "CTO 带着大家在排查。根因当时我们也没立刻弄明白。"
    },
    {
      "id": "investigation-n2",
      "state": "investigation",
      "speaker": "narrator",
      "basis": "staging",
      "text": "桌上有本笔记本。先把能确认的事理清楚。"
    },
    {
      "id": "investigation-cto-prompt",
      "state": "investigation",
      "speaker": "cto",
      "basis": "staging",
      "text": "你那边也一起看看，我们本来就一起干这件事。"
    },
    {
      "id": "investigation-confirm-1",
      "state": "investigation",
      "speaker": "player",
      "basis": "staging",
      "text": "（用户反馈看过了，情况记下来。）",
      "shownWhen": [
        "cto_informed",
        "feedback_reviewed",
        "incident_seen",
        "report_read"
      ]
    },
    {
      "id": "investigation-confirm-2",
      "state": "investigation",
      "speaker": "player",
      "basis": "staging",
      "text": "（影响也确认了，不止一个人。）",
      "shownWhen": [
        "cto_informed",
        "impact_confirmed",
        "incident_seen",
        "report_read"
      ]
    },
    {
      "id": "investigation-confirm-3",
      "state": "investigation",
      "speaker": "player",
      "basis": "staging",
      "text": "（登录页我又去看了一遍，还是老样子。）",
      "shownWhen": [
        "cto_informed",
        "incident_seen",
        "recheck_visited",
        "report_read"
      ]
    },
    {
      "id": "investigation-not-yet",
      "state": "investigation",
      "speaker": "narrator",
      "basis": "staging",
      "text": "笔记本上还没打满勾，先把自己能确认的确认完。"
    },
    {
      "id": "investigation-cto-3",
      "state": "investigation",
      "speaker": "cto",
      "basis": "staging",
      "text": "先到这里。你去旁边缓缓，这边还有大家。"
    },
    {
      "id": "observe-bookshelf-investigation",
      "state": "investigation",
      "speaker": "narrator",
      "basis": "staging",
      "text": "书架上摆着翻旧的 JavaScript 书。有本借出去又被人放回来的，书脊都弯了。（游戏里的观察，不代表当时的书架。）"
    },
    {
      "id": "observe-plant-investigation",
      "state": "investigation",
      "speaker": "narrator",
      "basis": "staging",
      "text": "窗边的绿植长得挺精神，谁空下来就顺手浇一点水。（游戏里的观察，不代表当时的样子。）"
    },
    {
      "id": "observe-mug-investigation",
      "state": "investigation",
      "speaker": "narrator",
      "basis": "staging",
      "text": "CTO 桌上的保温杯，贴着张旧贴纸，边角都翘起来了。（游戏里的观察，不代表当时的摆设。）"
    },
    {
      "id": "investigation-short",
      "state": "investigation",
      "speaker": "cto",
      "basis": "staging",
      "text": "这件事我们一直一起盯着，别一个人钻进去。",
      "shownWhen": [
        "cto_informed",
        "incident_seen",
        "report_read"
      ]
    },
    {
      "id": "restored-n1",
      "state": "restored",
      "speaker": "narrator",
      "basis": "fact_paraphrase",
      "text": "又忙了一阵，登录故障前后大概两个小时。"
    },
    {
      "id": "restored-cto-1",
      "state": "restored",
      "speaker": "cto",
      "basis": "staging",
      "text": "好了，没事了，别太自责。"
    },
    {
      "id": "restored-colleague-1",
      "state": "restored",
      "speaker": "colleague",
      "basis": "staging",
      "text": "没关系，大家都经历过。"
    },
    {
      "id": "restored-n3",
      "state": "restored",
      "speaker": "narrator",
      "basis": "fact_paraphrase",
      "text": "CTO、老板、同事都来宽慰过我，大意是这样；当时原话我记不清了。"
    },
    {
      "id": "restored-player-1",
      "state": "restored",
      "speaker": "player",
      "basis": "staging",
      "text": "（我点点头。）"
    },
    {
      "id": "restored-n4",
      "state": "restored",
      "speaker": "narrator",
      "basis": "staging",
      "text": "我把这次的事记了一页，留给 CTO 和同事，请他们有空看看。"
    },
    {
      "id": "learning-n1",
      "state": "learning",
      "speaker": "narrator",
      "basis": "fact_paraphrase",
      "text": "事后我们补了测试，也补了注释，说清楚这里为什么会踩坑。"
    },
    {
      "id": "learning-n2",
      "state": "learning",
      "speaker": "narrator",
      "basis": "staging",
      "text": "桌上多了一张便签，代码旁边多了一行注释。都看完，再写下来。"
    },
    {
      "id": "learning-cto-1",
      "state": "learning",
      "speaker": "cto",
      "basis": "staging",
      "text": "你有空也看看这两处，以后心里有数。"
    },
    {
      "id": "learning-player-1",
      "state": "learning",
      "speaker": "player",
      "basis": "staging",
      "text": "（两点我都过一遍，再写下来。）"
    },
    {
      "id": "learning-test-first",
      "state": "learning",
      "speaker": "narrator",
      "basis": "staging",
      "text": "便签上是这次补测的清单，写得简单。"
    },
    {
      "id": "learning-test-copy",
      "state": "learning",
      "speaker": "narrator",
      "basis": "staging",
      "text": "清单又看了一遍。以后别让要用的路径自己溜走。",
      "shownWhen": [
        "comfort_read",
        "cto_informed",
        "feedback_reviewed",
        "impact_confirmed",
        "incident_seen",
        "outage_over",
        "recheck_visited",
        "report_read",
        "test_reviewed"
      ]
    },
    {
      "id": "learning-comment-first",
      "state": "learning",
      "speaker": "narrator",
      "basis": "staging",
      "text": "注释只有短短几句，说这里为什么会踩坑、以后改的人要留意什么。"
    },
    {
      "id": "learning-comment-copy",
      "state": "learning",
      "speaker": "narrator",
      "basis": "staging",
      "text": "注释又看了一遍。这个坑，以后还得自己留心。",
      "shownWhen": [
        "comfort_read",
        "comment_reviewed",
        "cto_informed",
        "feedback_reviewed",
        "impact_confirmed",
        "incident_seen",
        "outage_over",
        "recheck_visited",
        "report_read"
      ]
    },
    {
      "id": "learning-pending",
      "state": "learning",
      "speaker": "narrator",
      "basis": "staging",
      "text": "测试和注释还有没看的，先看完。",
      "shownWhen": [
        "comfort_read",
        "cto_informed",
        "feedback_reviewed",
        "impact_confirmed",
        "incident_seen",
        "outage_over",
        "recheck_visited",
        "report_read"
      ]
    },
    {
      "id": "learning-manual-1",
      "state": "learning",
      "speaker": "narrator",
      "basis": "staging",
      "text": "手册翻到新的一页。上面写着：上线要负责；出了事，大家会一起扛。"
    },
    {
      "id": "observe-bookshelf-learning",
      "state": "learning",
      "speaker": "narrator",
      "basis": "staging",
      "text": "书架上摆着翻旧的 JavaScript 书。有本借出去又被人放回来的，书脊都弯了。（游戏里的观察，不代表当时的书架。）"
    },
    {
      "id": "observe-plant-learning",
      "state": "learning",
      "speaker": "narrator",
      "basis": "staging",
      "text": "窗边的绿植长得挺精神，谁空下来就顺手浇一点水。（游戏里的观察，不代表当时的样子。）"
    },
    {
      "id": "observe-mug-learning",
      "state": "learning",
      "speaker": "narrator",
      "basis": "staging",
      "text": "CTO 桌上的保温杯，贴着张旧贴纸，边角都翘起来了。（游戏里的观察，不代表当时的摆设。）"
    },
    {
      "id": "complete-n1",
      "state": "complete",
      "speaker": "narrator",
      "basis": "staging",
      "text": "这页手册，往后会一直带着。"
    },
    {
      "id": "complete-n2",
      "state": "complete",
      "speaker": "narrator",
      "basis": "staging",
      "text": "（南京深夜里读书的章节在后面。本章到此结束。）"
    }
  ],

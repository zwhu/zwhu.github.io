  "states": [
    {
      "id": "office",
      "title": "办公室",
      "budgetSeconds": 25,
      "goal": "从门口走到自己的工位电脑，打开论坛，看清用户不能登录的反馈。",
      "playerAction": "走到 forum_pc 南侧 [9,6]，按 E／空格（手机点 A 按钮），读帖后点“确认，去处理”。路上可顺手看书架、绿植、保温杯。",
      "enterFlags": [],
      "repeatRule": "论坛已读后再交互显示 office-reopen，不改变状态。",
      "endCondition": "在 forum_pc 点“确认，去处理”，触发 open_forum_post。",
      "feedback": "论坛面板出现，高亮“无法登录”；确认后进入 report。任务条改为“把反馈告诉 CTO”。",
      "checkpoint": false
    },
    {
      "id": "report",
      "title": "告诉 CTO",
      "budgetSeconds": 20,
      "goal": "把论坛反馈告诉 CTO，主动跟他一起处理。",
      "playerAction": "读旁白与我的反应，点“去找 CTO”解锁移动，走到 cto_pc 南侧 [15,6] 交互读完对话。",
      "enterFlags": [
        "report_read"
      ],
      "repeatRule": "report 的对话只在进入 report 后播放一次；刷新会回到最近检查点，已读论坛时再交互只显示 office-reopen，不会重复写 report_read。",
      "endCondition": "cto_pc 对话读完，触发 talk_to_cto。",
      "feedback": "CTO 说“先别一个人扛”。状态进入 incident：我的工位电脑仍在正常登录页，CTO 换成站位 [16,6]，等玩家过来。",
      "checkpoint": false
    },
    {
      "id": "incident",
      "title": "呆住",
      "budgetSeconds": 20,
      "goal": "亲眼看登录框交不出结果，承认自己当下不知道怎么办。",
      "playerAction": "看 1.5 秒演示（可按跳过键，改为一段说明句）；随后走到 cto_pc [15,6] 对话读完。",
      "enterFlags": [
        "report_read",
        "cto_informed"
      ],
      "repeatRule": "演示与对话在 incident 只播一次；跳过键只压缩表达。",
      "endCondition": "cto_pc 对话读完，触发 see_login_failure。",
      "feedback": "登录框按钮点了不动，画面只给静止与短闪，不显示报错与日志；CTO 招呼大家，对话后进入 investigation，可自由走动。",
      "checkpoint": false
    },
    {
      "id": "investigation",
      "title": "一起排查",
      "budgetSeconds": 40,
      "goal": "在 CTO 带领下做自己能确认的事：看反馈、确认影响、复查登录页。不猜根因。",
      "playerAction": "到 cto_pc [15,6] 对话，三项确认任选顺序，每项都要按“确认我去看了”，每项各点一次（配对白见下表）；三项齐全后按“这轮排查先到这里”。",
      "enterFlags": [
        "report_read",
        "cto_informed",
        "incident_seen"
      ],
      "repeatRule": "已确认的项再点不再计入，也不重复加标记（investigation-short）；三项之间无先后顺序。",
      "endCondition": "三项标记齐全后按“这轮排查先到这里”，触发 resume_narrative。",
      "feedback": "笔记本上勾选依次亮起，任务条显示“排查 0/3→3/3”；继续按钮只在 3/3 出现。转场里时间推进两小时，玩家不需要真实等待。",
      "checkpoint": true
    },
    {

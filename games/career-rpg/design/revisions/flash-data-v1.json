  "states": [
    {
      "id": "office",
      "goal": "走进南京办公室，找到自己的工位并打开论坛。",
      "playerAction": "四向走动；靠近电脑按交互键，或触控点交互按钮。",
      "feedback": "靠近工位时显示“查看论坛”提示；白板、饮水机、沙发、绿植显示可选观察提示，不阻挡主线。",
      "checkpoint": true
    },
    {
      "id": "report",
      "goal": "读论坛反馈，确认有真实用户无法登录。",
      "playerAction": "阅读论坛面板，确认反馈内容后关闭面板。",
      "feedback": "论坛面板只显示用户描述与时间线占位，不显示编造日志；确认后进入 incident。",
      "checkpoint": true
    },
    {
      "id": "incident",
      "goal": "看见登录框故障，经历短暂的呆住，等 CTO 过来。",
      "playerAction": "靠近登录演示触发短演出；可按继续键跳过停顿。",
      "feedback": "画面短暂停住，输入被锁；CTO 走入画面后恢复控制，不强制长等待。",
      "checkpoint": false
    },
    {
      "id": "investigation",
      "goal": "和 CTO、同事一起确认影响范围与参与排查。",
      "playerAction": "与 CTO 对话，查看论坛反馈与登录现象；不做技术谜题。",
      "feedback": "对话只推进“收反馈、看现象、同步进展”，不给出真实根因或突破线索。",
      "checkpoint": true
    },
    {
      "id": "restored",
      "goal": "通过叙事转场确认登录恢复，读同事的安慰。",
      "playerAction": "阅读转场卡与安慰对白，可跳过文字。",
      "feedback": "用“两小时后”转场卡交代时间，不模拟真实等待；恢复不作为玩家点按钮修好的结果。",
      "checkpoint": true
    },
    {
      "id": "learning",
      "goal": "确认补测试、查看坑点注释，把经验写进工作手册。",
      "playerAction": "依次查看测试便签、坑点注释，再走到书架写手册。",
      "feedback": "手册新增一条记录；不要求玩家编写真实代码，也不显示经验值或评分。",
      "checkpoint": true
    },
    {
      "id": "complete",
      "goal": "回看工作手册新增记录，结束本章或重玩。",
      "playerAction": "打开手册查看记录，选择结束或重玩。",
      "feedback": "显示章节完成；可回到最近检查点重看，不倒退完成标记。",
      "checkpoint": true
    }
  ],

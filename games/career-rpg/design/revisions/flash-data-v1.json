  "dialogues": [
    {
      "id": "office_whiteboard_optional",
      "state": "office",
      "speaker": "narrator",
      "text": "白板上还留着上线前的检查项，几个名字被红笔圈过。",
      "basis": "staging"
    },
    {
      "id": "office_plant_optional",
      "state": "office",
      "speaker": "narrator",
      "text": "窗边的绿植有点蔫，大概是这几天没人顾得上浇水。",
      "basis": "staging"
    },
    {
      "id": "report_forum_post",
      "state": "report",
      "speaker": "player",
      "text": "论坛里有人说登录不上，换浏览器、重新输密码都没用。",
      "basis": "fact_paraphrase"
    },
    {
      "id": "report_real_users",
      "state": "report",
      "speaker": "narrator",
      "text": "这不是演示环境。第一次有真实用户在线上被挡在门外。",
      "basis": "staging"
    },
    {
      "id": "incident_freeze",
      "state": "incident",
      "speaker": "narrator",
      "text": "我盯着登录框，脑子空了一下，手还搭在鼠标上。",
      "basis": "staging"
    },
    {
      "id": "incident_cto_arrives",
      "state": "incident",
      "speaker": "cto",
      "text": "先别一个人扛。把用户反馈和看到的现象摆到一起，我们一起查。",
      "basis": "staging"
    },
    {
      "id": "investigation_scope",
      "state": "investigation",
      "speaker": "player",
      "text": "我先确认是单个账号，还是登录入口整体受影响。",
      "basis": "staging"
    },
    {
      "id": "investigation_divide",
      "state": "investigation",
      "speaker": "cto",
      "text": "你收着用户反馈，我盯服务状态，有新情况就在群里同步。",
      "basis": "staging"
    },
    {
      "id": "investigation_colleague",
      "state": "investigation",
      "speaker": "colleague",
      "text": "我也在。需要复现步骤的话，我来跟。",
      "basis": "staging"
    },
    {
      "id": "restored_two_hours",
      "state": "restored",
      "speaker": "narrator",
      "text": "两个小时后，登录恢复。那两小时怎么过来的，我只记得群里消息一直没停。",
      "basis": "fact_paraphrase"
    },
    {
      "id": "restored_cto_comfort",
      "state": "restored",
      "speaker": "cto",
      "text": "上线出问题不稀奇。把它变成以后不会再犯的经验，才算没白折腾。",
      "basis": "staging"
    },
    {
      "id": "restored_colleague_comfort",
      "state": "restored",
      "speaker": "colleague",
      "text": "先吃饭吧，已经恢复了，别一直坐着。",
      "basis": "staging"
    },
    {
      "id": "learning_add_test",
      "state": "learning",
      "speaker": "player",
      "text": "这次没覆盖到的登录路径，得补上测试。",
      "basis": "fact_paraphrase"
    },
    {
      "id": "learning_trap_comment",
      "state": "learning",
      "speaker": "narrator",
      "text": "我在容易踩坑的地方写下注释，说明为什么不能想当然。",
      "basis": "fact_paraphrase"
    },
    {
      "id": "learning_manual",
      "state": "learning",
      "speaker": "player",
      "text": "把处理过程记进工作手册，下次遇到类似情况有据可查。",
      "basis": "fact_paraphrase"
    },
    {
      "id": "complete_manual_entry",
      "state": "complete",
      "speaker": "narrator",
      "text": "工作手册多了一条记录。南京的第一次上线，到这里告一段落。",
      "basis": "staging"
    }
  ],
